<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MindAttic.Legion</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MindAttic.Legion</AssemblyName>
    <!-- Whole-number versioning: major-only bumps (3.0.0 → 4.0.0 → 5.0.0). Minor/patch stay 0. -->
    <Version>9.0.0</Version>
    <PackageId>MindAttic.Legion</PackageId>
    <Title>MindAttic.Legion</Title>
    <Authors>MindAttic</Authors>
    <Company>MindAttic</Company>
    <Description>One-stop shop for orchestrating groups of LLMs as a "legion" — voting, polling, scoring, proofreading, and persona-driven multi-voter workflows. Bundles a 1024-persona library. Credential resolution flows through MindAttic.Vault: hosts call MindAtticCredentialStore.UseConfiguration(IConfiguration) to consume User Secrets / App Service Application Settings / Azure Key Vault, with the legacy %APPDATA%/MindAttic/LLM file kept as a backward-compat fallback. The bundled CLI wires this automatically.</Description>
    <PackageTags>mindattic;legion;llm;anthropic;openai;voting;multi-llm;ai;agents</PackageTags>
    <PackageProjectUrl>https://github.com/mindattic/MindAttic.Legion</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mindattic/MindAttic.Legion.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Copyright>Copyright (c) 2026 MindAttic</Copyright>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE"   Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The 1024 personas' latest psychometric profiles (id → profile), so the
         package delivers profile-carrying personas to consumers via
         PersonaLibrary.Profiles without any external data source. -->
    <EmbeddedResource Include="Resources\psychometric-profiles.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MindAttic.Vault" Version="1.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MindAttic.Legion.Tests" />
  </ItemGroup>

</Project>
