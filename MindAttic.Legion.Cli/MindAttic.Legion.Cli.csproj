<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MindAttic.Legion.Cli</RootNamespace>
    <AssemblyName>legion</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MindAttic.Legion\MindAttic.Legion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pulls in IConfigurationBuilder and the JSON provider so the CLI can
         compose the %APPDATA%\MindAttic credential files / env vars and hand the
         result to MindAtticCredentialStore.UseConfiguration. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MindAttic.Legion.Tests" />
  </ItemGroup>

</Project>
